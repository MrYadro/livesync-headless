# livesync-headless server configuration.
# Copy to config/env.local and adjust. Flags and environment variables override this file.
# config/env.local is gitignored - uncommenting secrets there is safe.

# ── Paths ───────────────────────────────────────────────────────────────────

# Vault directory (the actual markdown files). Default: ~/vault
#VAULT_DIR=/home/user/vault

# Pinned upstream clone/build tree. Default: ~/opt/obsidian-livesync
#UPSTREAM_DIR=/home/user/opt/obsidian-livesync

# ── Sync behaviour ──────────────────────────────────────────────────────────

# Poll CouchDB every N seconds instead of the _changes feed. Default: unset (LiveSync mode)
#SYNC_INTERVAL=

# Pull-only test mode: no writes ever reach the remote DB (see README, Read-only mode)
#READ_ONLY=1

# ── Install-time settings (only needed when settings.json does not exist yet;
#     values land in the 0600 settings.json, then can be removed here) ──────

# E2E passphrase - must match your other devices. Current plugin versions use
# the same passphrase for Obfuscate Properties; set OBFUSCATE_PASSPHRASE only
# for legacy setups where the two differ.
#E2E_PASSPHRASE=
#OBFUSCATE_PASSPHRASE=

# ── Read-only guard (couchdb-readonly.sh on/off; prompted if unset) ────────

#COUCHDB_ADMIN_USER=
#COUCHDB_ADMIN_PASSWORD=

# ── Setup URI import (import-uri.sh; prompted if unset) ────────────────────

#SETUP_URI_PASSPHRASE=

# ── Healthcheck ─────────────────────────────────────────────────────────────

# Accept encrypt=false settings during install/verify (discouraged)
#ALLOW_PLAINTEXT=1
